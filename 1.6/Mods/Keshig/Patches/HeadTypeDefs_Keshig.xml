<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Det's Xenotypes - Keshig</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationRemove">
                    <xpath>/Defs/GeneDef[defName="DV_Jaw_Split"]/forcedHeadTypes</xpath>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs</xpath>
                    <value>
						<FacialAnimation.HeadTypeDef>
							<defName>DV_Jaw_Split_Head</defName>
							<texPath>Keshig/Head</texPath>
							<shader>Map/CutoutSkin</shader>
							<shaderColorOverride>Map/CutoutSkinOverride</shaderColorOverride>
							<targetGeneDefs>
								<li>DV_Jaw_Split</li>
							</targetGeneDefs>
						</FacialAnimation.HeadTypeDef>

						<FacialAnimation.MouthTypeDef>
							<defName>DV_Jaw_Split_Jaw</defName>
							<texPath>Keshig/Jaw</texPath>
							<shader>Map/CutoutSkin</shader>
							<shaderColorOverride>Map/CutoutSkinOverride</shaderColorOverride>
							<targetGeneDefs>
								<li>DV_Jaw_Split</li>
							</targetGeneDefs>
						</FacialAnimation.MouthTypeDef>
					</value>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>
