    <!-- Minotaur.BovineHead : "original heads, animated eyes only" mode.
         Facial Animation deletes the vanilla head draw request for any pawn it draws, so the
         source mod's head cannot simply be left showing underneath - it has to BE the Facial
         Animation head. These are the source mod's own head textures, renamed to the shape
         name Facial Animation looks for. The mouth is blanked because it would not line up
         with a bovine muzzle. -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs</xpath>
        <value>
            <FacialAnimation.HeadTypeDef>
                <defName>MinotaurOriginal_RBM_HeadAv1</defName>
                <texPath>Minotaur/Head_Original/RBM_HeadAv1</texPath>
                <shader>Map/CutoutSkin</shader>
                <shaderColorOverride>Map/CutoutSkinOverride</shaderColorOverride>
                <probability>0.1667</probability>
                <targetGeneDefs>
                    <li>RBM_BovineHead</li>
                </targetGeneDefs>
            </FacialAnimation.HeadTypeDef>

            <FacialAnimation.HeadTypeDef>
