<?xml version="1.0" encoding="utf-8" ?>
<!-- Gated by LoadFolders: IfModActive="tug.Minotaur" -->
<Patch>
    <!-- Minotaur.BovineHead -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/GeneDef[defName="RBM_BovineHead"]/renderNodeProperties</xpath>
        <value>
                <li>
                    <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
                    <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
                    <texPaths>
                        <li>Minotaur/Head_Blank/normal</li>
                        <li>Minotaur/Head_Blank/normal</li>
                        <li>Minotaur/Head_Blank/normal</li>
                        <li>Minotaur/Head_Blank/normal</li>
                        <li>Minotaur/Head_NoseRing/normal</li>
                    </texPaths>
                    <colorType>Custom</colorType>
                    <color>(255,215,0)</color>
                    <parentTagDef>Head</parentTagDef>
                    <useSkinShader>false</useSkinShader>
                    <useRottenColor>false</useRottenColor>
                    <rotDrawMode>Fresh, Rotting</rotDrawMode>
                    <drawData>
                        <defaultData>
                            <layer>61</layer>
                            <offset>(0,0,0)</offset>
                        </defaultData>
                        <dataNorth>
                            <layer>-2</layer>
                            <offset>(0,0,0)</offset>
                        </dataNorth>
                        <dataSouth>
                            <layer>61</layer>
                            <offset>(0,0,0)</offset>
                        </dataSouth>
                        <dataEast>
                            <layer>61</layer>
                            <offset>(0,0,0)</offset>
                        </dataEast>
                        <dataWest>
                            <layer>61</layer>
                            <offset>(0,0,0)</offset>
                        </dataWest>
                    </drawData>
                </li>
        </value>
    </Operation>
