<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Erin's Rhy'aeth</li>
        </mods>

        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationRemove">
                    <xpath>/Defs/GeneDef[defName="ERN_RhyaethHead"]/forcedHeadTypes</xpath>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs</xpath>
                    <value>
                        <FacialAnimation.HeadTypeDef>
                            <defName>ERN_RhyaethHead</defName>
                            <texPath>DragonNose</texPath>
                            <shader>Map/CutoutSkin</shader>
                            <shaderColorOverride>Map/CutoutSkinOverride</shaderColorOverride>
                            <probability>1</probability>
                            <targetGeneDefs>
                                <li>ERN_RhyaethHead</li>
                            </targetGeneDefs>
                        </FacialAnimation.HeadTypeDef>
                        <FacialAnimation.MouthTypeDef>
                            <defName>ERN_RhyaethMouthBlank</defName>
                            <texPath>Mouth/BlankMouth</texPath>
                            <shader>Map/Transparent</shader>
                            <targetGeneDefs>
                                <li>ERN_RhyaethHead</li>
                            </targetGeneDefs>
                        </FacialAnimation.MouthTypeDef>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>
