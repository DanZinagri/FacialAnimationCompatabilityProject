<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Alpha Genes</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationRemove">
					<xpath>/Defs/GeneDef[defName="AG_FoxFace"]/forcedHeadTypes</xpath>
				</li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs</xpath>
                    <value>
                        <FacialAnimation.HeadTypeDef>
                            <defName>AG_FoxFace</defName>
                            <texPath>CanineNose</texPath>
                            <probability>1</probability>
                            <shader>Map/CutoutSkin</shader>
                            <shaderColorOverride>Map/CutoutSkinOverride</shaderColorOverride>
                            <targetGeneDefs>
                                <li>AG_FoxFace</li>
                            </targetGeneDefs>
                        </FacialAnimation.HeadTypeDef>
                    </value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>/Defs/GeneDef[defName="AG_AnimusEars"]/renderNodeProperties/li/texPath</xpath>
                    <value>
                        <texPath>Things/Pawn/Humanlike/HeadAttachments/CanineEars/CanineEars</texPath>
                    </value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>/Defs/GeneDef[defName="AG_AnimusEars"]/renderNodeProperties/li/colorType</xpath>
                    <value>
                        <colorType>Hair</colorType>
                    </value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>/Defs/GeneDef[defName="AG_AnimusEars"]/renderNodeProperties/li/useSkinShader</xpath>
                    <value>
                        <useSkinShader>False</useSkinShader>
                    </value>
                </li>
                <li Class="PatchOperationRemove">
                    <xpath>/Defs/GeneDef[defName="AG_DrakonoriHead"]/forcedHeadTypes</xpath>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs</xpath>
                    <value>
                        <FacialAnimation.HeadTypeDef>
                            <defName>AG_DrakonoriHead</defName>
                            <texPath>DragonNose</texPath>
                            <probability>1</probability>
                            <shader>Map/CutoutSkin</shader>
                            <shaderColorOverride>Map/CutoutSkinOverride</shaderColorOverride>
                            <targetGeneDefs>
                                <li>AG_DrakonoriHead</li>
                            </targetGeneDefs>
                        </FacialAnimation.HeadTypeDef>
                        <FacialAnimation.MouthTypeDef>
                            <defName>AG_DrakonoriHeadMouthBlank</defName>
                            <texPath>Mouth/BlankMouth</texPath>
                            <shader>Map/Transparent</shader>
                            <targetGeneDefs>
                                <li>AG_DrakonoriHead</li>
                            </targetGeneDefs>
                        </FacialAnimation.MouthTypeDef>
                    </value>
                </li>
                <li Class="PatchOperationRemove">
                    <xpath>/Defs/GeneDef[defName="AG_RockSpurs"]/renderNodeProperties</xpath>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs</xpath>
                    <value>
                        <FacialAnimation.HeadTypeDef>
                            <defName>AG_RockSpursHead</defName>
                            <texPath>Rocky</texPath>
                            <probability>1</probability>
                            <shader>Map/CutoutSkin</shader>
                            <shaderColorOverride>Map/CutoutSkinOverride</shaderColorOverride>
                            <targetGeneDefs>
                                <li>AG_RockSpurs</li>
                            </targetGeneDefs>
                        </FacialAnimation.HeadTypeDef>
                    </value>
                </li>
                <li Class="PatchOperationRemove">
                    <xpath>/Defs/GeneDef[defName="AG_VenomFangs"]/renderNodeProperties</xpath>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>
