<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <!-- Auraeyl.Head -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs</xpath>
        <value>
            <FacialAnimation.HeadTypeDef>
                <defName>ERN_AuraeylHead</defName>
                <texPath>Auraeyl</texPath>
                <probability>1</probability>
                <shader>Map/CutoutSkin</shader>
                <shaderColorOverride>Map/CutoutSkinOverride</shaderColorOverride>
                <targetGeneDefs>
                    <li>ERN_AuraeylHead</li>
                </targetGeneDefs>
            </FacialAnimation.HeadTypeDef>
        </value>
    </Operation>

    <!-- Auraeyl.Head : muzzle marking only, kept on the secondary fur colour.
         Appended into the existing list - this gene already carries its fur node. -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/GeneDef[defName="ERN_AuraeylBody"]/renderNodeProperties</xpath>
        <value>
                <li>
                    <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
                    <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
                    <texPath>Auraeyl_Markings/Male/normal</texPath>
                    <texPathFemale>Auraeyl_Markings/Female/normal</texPathFemale>
                    <colorType>Skin</colorType>
                    <parentTagDef>Head</parentTagDef>
                    <useSkinShader>false</useSkinShader>
                    <useRottenColor>false</useRottenColor>
                    <rotDrawMode>Fresh, Rotting</rotDrawMode>
                    <drawData>
                        <defaultData>
                            <layer>50.1</layer>
                        </defaultData>
                    </drawData>
                </li>
        </value>
    </Operation>

</Patch>
