<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Det's Xenotypes - Brawnum</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationRemove">
                    <xpath>/Defs/GeneDef[defName="DV_Nose_Snout"]/renderNodeProperties</xpath>
                </li>
                <li Class="PatchOperationRemove">
                    <xpath>/Defs/GeneDef[defName="DV_Nose_Snout"]/forcedHeadTypes</xpath>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs</xpath>
                    <value>
						<FacialAnimation.HeadTypeDef>
							<defName>DV_Nose_Snout_Head</defName>
							<texPath>Brawnum</texPath>
							<shader>Map/CutoutSkin</shader>
							<shaderColorOverride>Map/CutoutSkinOverride</shaderColorOverride>
							<targetGeneDefs>
								<li>DV_Nose_Snout</li>
							</targetGeneDefs>
						</FacialAnimation.HeadTypeDef>
					</value>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>
