<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Big and Small - Genes &amp; More</li>
    </mods>
    <match Class="PatchOperationFindMod">
      <mods>
        <li>[NL] Facial Animation - WIP</li>
      </mods>
      <match Class="PatchOperationSequence">
        <operations>

          <!-- Create comps node if missing -->
          <li Class="PatchOperationConditional">
            <xpath>/Defs/ThingDef[defName="BS_InsectoidHumanoid_FourArmed"]/comps</xpath>
            <nomatch Class="PatchOperationAdd">
              <xpath>/Defs/ThingDef[defName="BS_InsectoidHumanoid_FourArmed"]</xpath>
              <value>
                <comps />
              </value>
            </nomatch>
          </li>

          <!-- Add Facial Animation comps -->
          <li Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="BS_InsectoidHumanoid_FourArmed"]/comps</xpath>
            <value>
              <li><compClass>FacialAnimation.DrawFaceGraphicsComp</compClass></li>
              <li><compClass>FacialAnimation.HeadControllerComp</compClass></li>
              <li><compClass>FacialAnimation.EyeballControllerComp</compClass></li>
              <li><compClass>FacialAnimation.LidControllerComp</compClass></li>
              <li><compClass>FacialAnimation.BrowControllerComp</compClass></li>
              <li><compClass>FacialAnimation.MouthControllerComp</compClass></li>
              <li><compClass>FacialAnimation.SkinControllerComp</compClass></li>
              <li><compClass>FacialAnimation.FacialAnimationControllerComp</compClass></li>
            </value>
          </li>

          <li Class="PatchOperationAdd">
            <xpath>/Defs</xpath>
            <value>
              <FacialAnimation.FaceAdjustmentDef>
                <defName>BS_InsectoidHumanoid_FourArmed_FaceAdjustment</defName>
                <RaceName>BS_InsectoidHumanoid_FourArmed</RaceName>
                <Size>(1.5,1.5)</Size>
                <RightEyeLabel>right compound eye</RightEyeLabel>
                <LeftEyeLabel>left compound eye</LeftEyeLabel>
              </FacialAnimation.FaceAdjustmentDef>
            </value>
          </li>

        </operations>
      </match>
      <nomatch Class="PatchOperationSequence">
        <operations />
      </nomatch>
    </match>
    <nomatch Class="PatchOperationSequence">
      <operations />
    </nomatch>
  </Operation>

</Patch>
