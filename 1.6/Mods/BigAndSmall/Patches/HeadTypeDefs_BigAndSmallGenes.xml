<?xml version="1.0" encoding="utf-8" ?>
<!-- Gated by LoadFolders: IfModActive="RedMattis.BigSmall.Core"

     Several targets here sit behind further gates inside Big and Small itself:
     BS_GhoulHead lives in its Anomaly folder, and BS_DragonHead / BS_SatanHead /
     BS_StonemaskHead come from its FacialAnim folder. Ops touching those stay wrapped
     in PatchOperationConditional. -->
<Patch>
    <!-- BigAndSmall.GhoulHead -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs</xpath>
        <value>
            <FacialAnimation.HeadTypeDef>
                <defName>BS_GhoulHead</defName>
                <texPath>BS_GhoulHead</texPath>
                <probability>1</probability>
                <shader>Map/CutoutSkin</shader>
                <shaderColorOverride>Map/CutoutSkinOverride</shaderColorOverride>
                <targetGeneDefs>
                    <li>BS_GhoulHead</li>
                </targetGeneDefs>
            </FacialAnimation.HeadTypeDef>
        </value>
    </Operation>
    <!-- BigAndSmall.DragonHead -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs</xpath>
        <value>
            <FacialAnimation.HeadTypeDef>
                <defName>BS_DragonHead</defName>
                <texPath>DragonNose</texPath>
                <probability>1</probability>
                <shader>Map/CutoutSkin</shader>
                <shaderColorOverride>Map/CutoutSkinOverride</shaderColorOverride>
                <targetGeneDefs>
                    <li>BS_DragonHead</li>
                </targetGeneDefs>
            </FacialAnimation.HeadTypeDef>
            <FacialAnimation.MouthTypeDef>
                <defName>BS_DragonHeadMouthBlank</defName>
                <texPath>Mouth/BlankMouth</texPath>
                <shader>Map/Transparent</shader>
                <targetGeneDefs>
                    <li>BS_DragonHead</li>
                </targetGeneDefs>
            </FacialAnimation.MouthTypeDef>
        </value>
    </Operation>
</Patch>
